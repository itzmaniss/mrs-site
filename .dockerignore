# Everything the build context does not need. This matters more than usual
# here: node_modules is ~500 MB and dist is ~5.6 MB, and both are rebuilt
# inside the image anyway. Shipping them would slow every build and risk
# baking a darwin-arm64 node_modules into a linux image.

# dependencies — reinstalled from the lockfile in the deps stage
node_modules/
**/node_modules/

# build output — regenerated in the build stage
dist/
.astro/

# vcs & tooling state
.git/
.gitignore
.gitattributes
.github/
.mise.toml
.claude/
.claude-flow/
.swarm/
.vscode/
.idea/
.DS_Store

# secrets — never in an image layer
.env
.env.*
!.env.example

# docs & agent instructions
*.md
!README.md

# local scratch
.playwright-mcp/
*.log
*.tsbuildinfo
menu-open.png

# docker's own files
Dockerfile
.dockerignore
