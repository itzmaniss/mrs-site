# Sanity — powers /guides. Optional: with these unset the build succeeds and
# /guides renders its empty state, so a fresh checkout needs no credentials.
#
# The v2 monorepo calls the first two NEXT_PUBLIC_SANITY_PROJECT_ID and
# NEXT_PUBLIC_SANITY_DATASET. The prefix meant something only to Next, so it is
# dropped here — nothing on this site reaches Sanity from the browser.
SANITY_PROJECT_ID=
SANITY_DATASET=

# GROQ API date. Leave unset to use the version pinned in src/lib/content.ts.
# SANITY_API_VERSION=

# Only needed for a private dataset, or to build against drafts. A public
# dataset reads faster without one, because the client can use the CDN.
# SANITY_API_READ_TOKEN=

# Canonical origin, for <link rel="canonical">, the sitemap and RSS.
# Defaults to https://myridesg.com. Set this on preview and staging deploys.
# SITE_URL=

# Extra hostnames the dev server should accept, comma-separated. Cloudflare
# tunnel domains are already allowed in astro.config.mjs.
# DEV_ALLOWED_HOSTS=
