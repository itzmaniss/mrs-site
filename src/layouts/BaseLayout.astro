---
import '@/styles/global.css'
import { SITE } from '@/consts'

interface Props {
  /** Page title. Rendered as "<title> — MyRideSG"; omit on the home page. */
  title?: string
  description?: string
  /** Absolute or root-relative path to the social image. */
  ogImage?: string
  /** Set true only on pages that must stay out of the index. */
  noindex?: boolean
  /**
   * Overrides the self-referencing canonical. Only for content that is
   * authored elsewhere and republished here — CMS-supplied canonicalUrl.
   */
  canonical?: string
}

const {
  title,
  description = SITE.description,
  ogImage,
  noindex = false,
  canonical: canonicalOverride,
} = Astro.props

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`
const canonical = canonicalOverride
  ? new URL(canonicalOverride, Astro.site).href
  : new URL(Astro.url.pathname, Astro.site).href
const socialImage = ogImage ? new URL(ogImage, Astro.site).href : undefined
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171110" />
    <!-- Tells the UA to render form controls, scrollbars and the like in the
         scheme the page actually uses, rather than assuming light. -->
    <meta name="color-scheme" content="light dark" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Must run before first paint, and must stay inline and unbundled — a
        deferred module would let the light palette paint first and then swap,
        which is the flash every theme toggle is judged on. It sits after the
        theme-color tags above so ThemeToggle can find them.

        `data-js` is what reveals the toggle button. Rendering it hidden and
        showing it here means a reader with JavaScript off never sees a control
        that cannot work, and no one sees it pop in late. */}
    <script is:inline>
      ;(() => {
        try {
          const stored = localStorage.getItem('myridesg-theme')
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored
          }
        } catch {}
        document.documentElement.dataset.js = ''
      })()
    </script>

    {/* Detaches the fragment from a cross-page anchor arrival BEFORE the target
        element is parsed, so the UA never has anything to scroll to and cannot
        paint a frame at the destination. SiteNav.astro then flies the reader
        there from the top; it reads the stashed value below instead of
        location.hash.

        This has to be inline and in <head>. SiteNav's copy is a bundled module,
        which runs after the document is parsed — in Chromium that landed before
        first paint every time, but the ordering is not guaranteed, and on a slow
        cold load of a long guide the browser could paint once at the fragment
        first. That flash is the whole bug, so the fix belongs where it cannot
        race.

        Gated identically to SiteNav's block, because a hash this script hides
        is a hash that script must be willing to use: fresh navigations only —
        back/forward and reload must land where the reader already was — and
        never under reduced motion, where the native jump is the correct
        behaviour. The navigation entry is already populated this early —
        measured at document_start with readyState "loading" — so no fallback to
        the deprecated performance.navigation is needed. */}
    <script is:inline>
      ;(() => {
        const hash = location.hash
        if (hash.length < 2) return

        try {
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
        } catch {
          return
        }

        const entry = performance.getEntriesByType('navigation')[0]
        if (entry?.type !== 'navigate') return

        window.__pendingHash = hash
        history.replaceState(history.state, '', location.pathname + location.search)
      })()
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <slot />
  </body>
</html>

<style is:global>
  /* Sticky footer. Every page passes the same three children into the slot —
     SiteNav, a <main>, then SiteFooter — so this belongs here rather than being
     repeated on each page.

     SiteNav is position:fixed and so contributes no flow height; the column
     only has to divide the viewport between <main> and the footer, which is why
     a bare min-h-dvh on <body> is enough and no header offset is needed.

     flex-grow on its own, keeping the default `auto` basis, rather than
     `flex: 1`: <main> stays sized by its own content and only absorbs space
     that is left over once min-height stretches <body> past it. A page taller
     than the viewport lays out exactly as it did before. */
  body > main {
    flex-grow: 1;
  }
</style>
