---
import { NAV } from '@/consts'

// "Get the app" used to open the web app, which is switched off. It now aims
// at the download block on the home page, and BaseLayout's platform script
// rewrites it straight to the reader's own store on a phone — so a tap on a
// phone installs, while a desktop click lands somewhere that shows both.
const GET_THE_APP = '/#get'
import ThemeToggle from './ThemeToggle.astro'
---

<header class="fixed inset-x-0 top-4 z-50 px-4 md:top-6">
  <nav
    class="mx-auto flex max-w-4xl items-center justify-between gap-6 rounded-pill bg-paper/95 px-5 py-3 shadow-[0_4px_32px_rgba(8,8,8,0.18)] backdrop-blur-sm md:px-6"
    aria-label="Primary"
  >
    <a
      href="/"
      data-home-link
      class="font-display text-xl font-700 tracking-tight whitespace-nowrap"
    >
      MyRide<span class="text-red">SG</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-ink/70 transition-colors hover:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <ThemeToggle />

      <a
        href={GET_THE_APP}
        data-store-link
        class="hidden min-h-10 items-center rounded-pill bg-ink px-5 text-sm font-semibold text-paper transition-opacity hover:opacity-85 sm:inline-flex"
      >
        Get the app
      </a>

      <details class="site-menu md:hidden">
        <summary aria-label="Menu">
          <span class="site-menu__bars" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
        </summary>

        <div class="site-menu__panel">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>

          <a href={GET_THE_APP} data-store-link class="site-menu__cta">Get the app</a>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-menu {
    position: relative;
  }

  /* ── Trigger ──────────────────────────────────────────────────────────── */

  .site-menu > summary {
    display: grid;
    place-items: center;
    inline-size: 2.75rem; /* 44px — full touch target */
    block-size: 2.75rem;
    border-radius: 9999px;
    cursor: pointer;
    list-style: none;
    transition: background-color 200ms ease;
  }

  .site-menu > summary::-webkit-details-marker {
    display: none;
  }

  .site-menu > summary:hover,
  .site-menu[open] > summary {
    background: --alpha(var(--color-ink) / 7%);
  }

  /* Three bars that fold into a cross. The outer pair translate to the centre
     and rotate; the middle one fades. Transform-only, so it stays on the
     compositor. */
  .site-menu__bars {
    position: relative;
    display: block;
    inline-size: 1.125rem;
    block-size: 0.75rem;
  }

  .site-menu__bars i {
    position: absolute;
    inset-inline: 0;
    block-size: 1.75px;
    border-radius: 2px;
    background: var(--color-ink);
    transition:
      transform 340ms cubic-bezier(0.65, 0, 0.35, 1),
      opacity 180ms ease;
  }

  .site-menu__bars i:nth-child(1) {
    top: 0;
  }
  .site-menu__bars i:nth-child(2) {
    top: 50%;
    translate: 0 -50%;
  }
  .site-menu__bars i:nth-child(3) {
    bottom: 0;
  }

  .site-menu[open] .site-menu__bars i:nth-child(1) {
    transform: translateY(0.365rem) rotate(45deg);
  }
  .site-menu[open] .site-menu__bars i:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.4);
  }
  .site-menu[open] .site-menu__bars i:nth-child(3) {
    transform: translateY(-0.365rem) rotate(-45deg);
  }

  /* ── Panel ────────────────────────────────────────────────────────────── */

  .site-menu__panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.6rem);
    inline-size: 13rem;
    padding: 0.5rem;
    border: 1px solid --alpha(var(--color-ink) / 8%);
    border-radius: 1.25rem;
    background: var(--color-paper);
    box-shadow: 0 18px 48px rgba(8, 8, 8, 0.22);
    transform-origin: top right;
  }

  .site-menu__panel ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-menu__panel a {
    display: block;
    padding: 0.7rem 0.85rem;
    border-radius: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: --alpha(var(--color-ink) / 78%);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .site-menu__panel a:hover {
    background: var(--color-soft);
    color: var(--color-ink);
  }

  .site-menu__cta {
    margin-top: 0.35rem;
    text-align: center;
    background: var(--color-ink);
    color: var(--color-paper) !important;
    font-weight: 600 !important;
  }

  .site-menu__cta:hover {
    background: var(--color-ink) !important;
    opacity: 0.85;
  }

  /* Entry animation. A keyframe on [open] is more reliable here than
     transitioning ::details-content: a dropdown wants scale and lift, not a
     height reveal, and the panel is absolutely positioned so its height never
     affects layout. Each row is staggered slightly behind the panel so the
     menu assembles rather than appearing all at once. */
  @media (prefers-reduced-motion: no-preference) {
    .site-menu[open] .site-menu__panel {
      animation: menu-panel-in 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .site-menu[open] .site-menu__panel a {
      animation: menu-row-in 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .site-menu[open] .site-menu__panel li:nth-child(1) a {
      animation-delay: 40ms;
    }
    .site-menu[open] .site-menu__panel li:nth-child(2) a {
      animation-delay: 75ms;
    }
    .site-menu[open] .site-menu__panel li:nth-child(3) a {
      animation-delay: 110ms;
    }
    .site-menu[open] .site-menu__cta {
      animation-delay: 145ms;
    }
  }

  @keyframes menu-panel-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes menu-row-in {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  // <details> has no notion of "click away to dismiss", which is the main thing
  // that makes a bare disclosure feel unfinished as a menu. Twelve lines fixes
  // that. Without this script the menu still opens and closes from its own
  // button, so the failure mode is merely less convenient, not broken.
  document.querySelectorAll<HTMLDetailsElement>('.site-menu').forEach((menu) => {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false
        menu.querySelector('summary')?.focus()
      }
    })

    // Navigating to an in-page anchor should dismiss it too.
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false
      })
    })
  })
</script>

<script>
  /* `scroll-behavior: smooth` in global.css only ever animates a scroll WITHIN
   * a document that is already loaded. Two of this nav's links are not that:
   *
   *   /#features, /#faq  from any page other than the home page, these are full
   *                      cross-document navigations. The new document is simply
   *                      rendered already scrolled to the target, so the reader
   *                      is deposited mid-page with no sense of having moved.
   *   /                  from the home page itself this is a same-page reload,
   *                      which the browser services as a navigation — a cut, not
   *                      a scroll back to the top.
   *
   * Both are restored here. If this script never runs, every href is still a
   * plain link that lands in exactly the right place; only the movement between
   * is lost, which is the correct thing to degrade.
   */

  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches

  /** `/index.html` and `/` are the same route once built. */
  const route = (path: string) => path.replace(/index\.html$/, '')

  /* ── Cross-page anchors ──────────────────────────────────────────────────
   *
   * Only a fresh navigation gets animated. A back or forward traversal must
   * land the reader exactly where they left — `history.scrollRestoration` is
   * deliberately left on its 'auto' default so the browser keeps doing that,
   * and replaying an animation over the top of a restore would both fight it
   * and misrepresent where they are. A reload is excluded for the same reason.
   */
  const navigation = performance.getEntriesByType('navigation')[0] as
    | PerformanceNavigationTiming
    | undefined

  // BaseLayout's inline head script detaches the fragment before the target is
  // ever parsed, and stashes it here — that is what guarantees the UA cannot
  // paint a frame at the destination first. It applies the same gates this block
  // does, so a stashed value is already known to be a fresh, non-reduced-motion
  // navigation. location.hash remains the fallback for the case where that
  // script did not run at all.
  const pending = (window as unknown as { __pendingHash?: string }).__pendingHash
  const hash = pending ?? location.hash
  const target =
    hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null

  if (target && navigation?.type === 'navigate' && !reduced()) {
    // Strip the fragment for the duration of the flight. The UA re-runs "scroll
    // to the fragment" as late layout shifts come in — a hero image landing,
    // a font swapping — and each of those would yank us to the destination
    // mid-animation. With no fragment in the document's URL there is nothing
    // for it to re-target. Already done by the head script in the normal path;
    // repeating it is harmless and covers the fallback.
    const bare = location.pathname + location.search
    history.replaceState(history.state, '', bare)

    // `scroll-behavior: smooth` applies to the legacy scrollTo(x, y) form too,
    // so this reset has to name `instant` explicitly. Left implicit it becomes
    // an animation of its own, running upwards into the one starting below.
    window.scrollTo({ top: 0, behavior: 'instant' })

    // Two frames. The first commits the reset, the second starts the animation
    // from a position the reader has actually been shown. Both in one frame
    // collapse into a single layout and the journey is invisible again — which
    // is the bug this whole block exists to fix.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        // scrollIntoView rather than a computed offset: the header is fixed, and
        // `:where([id]) { scroll-margin-top: 6rem }` in global.css already
        // accounts for it. Measuring the header here would duplicate that number
        // and then drift from it.
        target.scrollIntoView({ behavior: 'smooth', block: 'start' })

        // Put the fragment back once we have arrived, so the URL is shareable
        // and a reload lands in the same place. replaceState, never
        // `location.hash =`: assigning the hash would jump the page and push a
        // junk entry into history, whereas replaceState does neither.
        const restore = () => history.replaceState(history.state, '', bare + hash)

        if ('onscrollend' in window) {
          window.addEventListener('scrollend', restore, { once: true })
        } else {
          // Safari has no scrollend, so a fixed delay is the only option there.
          // Being early is harmless — replaceState does not scroll, and by then
          // the document has loaded, so the UA is no longer fragment-seeking.
          setTimeout(restore, 1000)
        }
      })
    })
  }

  /* ── Brand link ──────────────────────────────────────────────────────────
   *
   * From another page it stays an ordinary navigation. From the home page,
   * scrolled down, the reader is asking to go back to the top of the page they
   * are already on, and a reload is a poor way to say that.
   */
  document.querySelectorAll<HTMLAnchorElement>('[data-home-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      // Anything that is not a plain left click is the reader asking the browser
      // for something else — a new tab, a download, a saved link. Never take
      // those over.
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return
      }

      if (route(new URL(link.href).pathname) !== route(location.pathname)) return

      event.preventDefault()
      window.scrollTo({ top: 0, behavior: reduced() ? 'instant' : 'smooth' })

      // A lingering #faq would otherwise send the next reload straight back down
      // the page the reader just asked to leave.
      if (location.hash) {
        history.replaceState(history.state, '', location.pathname + location.search)
      }
    })
  })
</script>
