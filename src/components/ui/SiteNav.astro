---
import { NAV, STORE } from '@/consts'
---

<header class="fixed inset-x-0 top-4 z-50 px-4 md:top-6">
  <nav
    class="mx-auto flex max-w-4xl items-center justify-between gap-6 rounded-pill bg-paper/95 px-5 py-3 shadow-[0_4px_32px_rgba(8,8,8,0.18)] backdrop-blur-sm md:px-6"
    aria-label="Primary"
  >
    <a href="/" class="font-display text-xl font-700 tracking-tight whitespace-nowrap">
      MyRide<span class="text-red">SG</span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-7 md:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-ink/70 transition-colors hover:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={STORE.ios}
        class="hidden min-h-10 items-center rounded-pill bg-ink px-5 text-sm font-semibold text-paper transition-opacity hover:opacity-85 sm:inline-flex"
      >
        Get the app
      </a>

      <!-- Mobile menu: native <details>, so no JavaScript -->
      <details class="relative md:hidden" name="site-nav">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
          </svg>
        </summary>

        <ul
          class="absolute right-0 top-12 w-48 rounded-lg border border-ink/10 bg-paper p-2 shadow-[0_8px_32px_rgba(8,8,8,0.16)]"
        >
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-sm px-3 py-2.5 text-md font-medium text-ink/80 hover:bg-soft hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={STORE.ios}
              class="mt-1 block rounded-sm bg-ink px-3 py-2.5 text-md font-semibold text-paper"
            >
              Get the app
            </a>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>
