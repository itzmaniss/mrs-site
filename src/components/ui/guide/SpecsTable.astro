---
/**
 * `specsTable` block from the Sanity article body — a label/value list, used in
 * the guides for insurer comparisons, price tables and model specs.
 *
 * A <dl> rather than a <table>: every row in the dataset is a single
 * label/value pair, which is a description list, not tabular data.
 *
 * The wrapper scrolls on its own rather than letting a long value widen the
 * page — a guide read on a phone must never scroll horizontally as a whole.
 */
interface Row {
  label?: string
  value?: string
}

interface Props {
  node: { rows?: Row[] }
}

const { node } = Astro.props

// Rows are required by the schema, but a row missing either half renders as a
// blank line, so drop it. Documents written through the API skip validation.
const rows = (node.rows ?? []).filter(
  (row): row is Required<Row> => Boolean(row?.label && row?.value),
)
---

{
  rows.length > 0 && (
    <div class="my-7 overflow-x-auto rounded-xs border border-ink/12">
      <dl class="min-w-[20rem]">
        {rows.map((row, i) => (
          <div
            class:list={[
              'grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-4 px-4 py-3',
              i > 0 && 'border-t border-ink/12',
            ]}
          >
            <dt class="eyebrow self-center text-muted">{row.label}</dt>
            <dd class="text-md leading-relaxed text-ink">{row.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  )
}
