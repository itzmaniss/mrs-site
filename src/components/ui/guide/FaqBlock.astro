---
/**
 * `faq` block from the Sanity article body.
 *
 * Native <details>, reusing the `faq-item` utility from global.css so a guide
 * FAQ looks identical to the one on the home page. The open/close ANIMATION is
 * driven by the script in components/ui/Faq.astro, which is not on this page —
 * so these disclose instantly rather than sliding. That is the same degraded
 * state global.css already documents for JavaScript-off, and it is cosmetic.
 *
 * Also emits FAQPage structured data, matching Faq.astro: these guides exist to
 * be found, and it is the cleanest format for search and AI crawlers to extract.
 */
import { PortableText } from 'astro-portabletext'
import type { PortableTextProps } from 'astro-portabletext/types'

interface FaqItem {
  question?: string
  answer?: PortableTextProps['value']
}

interface Props {
  node: { items?: FaqItem[] }
}

const { node } = Astro.props

const items = (node.items ?? []).filter((item): item is FaqItem & { question: string } =>
  Boolean(item?.question),
)

/**
 * Flattens Portable Text spans to a plain string for the JSON-LD answer.
 * schema.org wants text, and structured data that disagrees with the visible
 * answer is worse than none — so this reads the same nodes the markup renders
 * rather than a separately authored summary.
 */
function toPlainText(value: unknown): string {
  if (!Array.isArray(value)) return ''
  return value
    .map((block: any) =>
      block?._type === 'block' && Array.isArray(block.children)
        ? block.children.map((child: any) => child?.text ?? '').join('')
        : '',
    )
    .filter(Boolean)
    .join('\n\n')
}

const answered = items
  .map((item) => ({ question: item.question, text: toPlainText(item.answer) }))
  .filter((item) => item.text)

const faqSchema =
  answered.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: answered.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.text },
        })),
      }
    : null
---

{
  items.length > 0 && (
    <div class="my-8 border-t border-ink/12">
      {items.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>

          <div class="max-w-xl pb-5 [&>p:last-child]:mb-0">
            <PortableText value={item.answer ?? []} />
          </div>
        </details>
      ))}
    </div>
  )
}

{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
