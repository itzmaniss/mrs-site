---
// Numbered because these genuinely are sequential — you cannot log against a
// bike you have not added. The numerals carry order, not decoration.
const STEPS = [
  {
    n: '01',
    title: 'Add your bike',
    body: 'Plate, model and renewal dates. Two minutes, once.',
  },
  {
    n: '02',
    title: 'Log as you go',
    body: 'Fill-ups, servicing and expenses, quick-added from any screen.',
  },
  {
    n: '03',
    title: 'Get reminded',
    body: 'Before road tax, COE, insurance and servicing fall due — not after.',
  },
]
---

<section class="bg-soft py-20 md:py-28">
  <div class="shell">
    <p class="eyebrow text-red">How it works</p>

    <h2 class="mt-4 text-display-sm md:text-display">Three steps. That's it.</h2>

    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {
        STEPS.map((step) => (
          <li class="rounded-xl bg-paper p-7 md:p-8">
            <p class="font-display text-display-sm leading-none font-700 text-red">{step.n}</p>
            <h3 class="mt-4 text-2xl">{step.title}</h3>
            <p class="mt-2 text-md leading-relaxed text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
