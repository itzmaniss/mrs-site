---
import { APP } from '@/consts'

interface Props {
  /** 'dark' sits on a light surface; 'light' sits on a dark surface. */
  tone?: 'dark' | 'light'
  class?: string
}

const { tone = 'dark', class: className = '' } = Astro.props

// One destination, so one button. The iOS/Android pair — and the user-agent
// script that collapsed it down to the relevant one on a phone — belong to the
// store-facing site and live on `on-release`; there is nothing to route by
// platform while the app is reached on the web.
const button =
  tone === 'light'
    ? 'bg-paper text-ink hover:opacity-85'
    : 'bg-ember text-on-dark hover:opacity-85'
---

<div class:list={['flex flex-wrap items-center gap-3', className]}>
  <a
    href={APP}
    class:list={[
      'inline-flex min-h-12 items-center rounded-pill px-7 text-md font-semibold transition-opacity',
      button,
    ]}
  >
    Open MyRideSG
  </a>
</div>
