---
const ITEMS = [
  'COE',
  'Road tax',
  'Insurance',
  'Servicing',
  'Mileage',
  'Fuel',
  'Expenses',
  'Workshops',
]

// The strip is duplicated so the -50% translate loops seamlessly. The second
// copy is aria-hidden so screen readers hear the list exactly once.
const strip = ITEMS.join(' · ') + ' · '
---

<div class="overflow-hidden bg-red py-3.5" role="presentation">
  <div class="ticker-track">
    <span class="font-display text-md tracking-[0.14em] whitespace-nowrap text-on-dark uppercase">
      {strip.repeat(6)}
    </span>
    <span
      class="font-display text-md tracking-[0.14em] whitespace-nowrap text-on-dark uppercase"
      aria-hidden="true"
    >
      {strip.repeat(6)}
    </span>
  </div>
</div>
