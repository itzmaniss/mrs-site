---
// Replaces the old "PROOF" section, which carried invented adoption counts
// (4,800 riders / 6,200 bikes / 87 workshops) and two invented testimonials.
// Both are forbidden by the Claim Guardrails in
// myridesg-v2/docs/marketing-site-creative-brief.md. This section proves local
// relevance through what the product actually does instead.
const FACTS = [
  {
    title: 'The renewal dates that matter here',
    body: 'COE, road tax and insurance are counted down from the day each one falls due, rather than left sitting in an email archive.',
  },
  {
    title: 'Recorded in SGD and kilometres',
    body: 'Every cost is stored in the currency you pay in and the distance you ride. No conversion and no estimation.',
  },
  {
    title: 'A Singapore workshop directory',
    body: 'Browse workshops by region and speciality, with the services and contact details needed to make a decision.',
  },
  {
    title: 'Fuel costs that reflect the pump',
    body: 'Log fill-ups against listed pump prices and the fuel cards you carry, so cost per kilometre stays accurate.',
  },
]
---

<section class="bg-paper py-20 md:py-28">
  <div class="shell">
    <p class="eyebrow text-red">Built for Singapore ownership</p>

    <h2 class="mt-4 max-w-2xl text-display-sm md:text-display">
      Everything a bike costs you here, in one place.
    </h2>

    <div class="mt-12 grid gap-px overflow-hidden rounded-xl bg-ink/10 sm:grid-cols-2">
      {
        FACTS.map((fact) => (
          <div class="bg-paper p-6 md:p-8">
            <h3 class="text-2xl">{fact.title}</h3>
            <p class="mt-2.5 text-md leading-relaxed text-muted">{fact.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
