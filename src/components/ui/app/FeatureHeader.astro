---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

/**
 * The app's destination-page header, ported from
 * myridesg-v2/apps/mobile/components/FeatureHeader.tsx.
 *
 * One charcoal band (brandCharcoal #393939, scheme-invariant there and here),
 * a shaped bottom edge, the title inline beside the back chevron, the tagline
 * under it, and the oversized 3D icon overflowing the bottom-right corner.
 *
 * Both feature screens on this page use the 'wave' edge, which is the shape
 * the registry gives fuel and workshops. The path below is shapePath('wave')
 * evaluated at w=390, h=172 with FEATURE_HEADER_AMP = 16:
 *
 *   M0 0 H390 V172 C241.8 140 156 172 0 172 Z
 *
 * preserveAspectRatio="none" lets it stretch to whatever the frame is, since
 * the frame here is narrower than a real device.
 */

interface Props {
  title: string
  /** The category's `tagline` in features/categories/registry.ts. */
  tagline: string
  icon: ImageMetadata
}

const { title, tagline, icon } = Astro.props
---

<header class="feat">
  <svg class="feat__shape" viewBox="0 0 390 172" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0 H390 V172 C241.8 140 156 172 0 172 Z" fill="var(--app-charcoal)"></path>
  </svg>

  <div class="feat__inner">
    <div class="feat__titlerow">
      <svg class="feat__back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <h4 class="feat__title">{title}</h4>
    </div>

    <p class="feat__tagline">{tagline}</p>
  </div>

  <Image src={icon} alt="" widths={[120, 240]} sizes="120px" class="feat__icon" loading="lazy" />
</header>

<style>
  .feat {
    position: relative;
    /* 2.9em top is the status-bar safe area — insets.top in the app, where the
       band is drawn from y=0 and the content is padded down past it. */
    padding: 2.9em 1em 2.6em;
    /* The band is dark in both schemes, so its text is fixed white rather than
       token-driven — same reasoning as GLOW_HEADER in the app. */
    color: #ffffff;
  }

  .feat__shape {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .feat__inner {
    position: relative;
    z-index: 1;
  }

  .feat__titlerow {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .feat__back {
    inline-size: 1.5em;
    block-size: 1.5em;
    flex-shrink: 0;
  }

  .feat__title {
    font-family: var(--font-sans);
    font-size: 2em;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .feat__tagline {
    margin-top: 0.45em;
    font-size: 1em;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Overflows the band's bottom-right corner, as in the app. z-index keeps it
     over the wave so the corner it sits on always reads as solid colour. */
  .feat__icon {
    position: absolute;
    right: 0.4em;
    bottom: 1.4em;
    z-index: 2;
    inline-size: 7em;
    block-size: auto;
  }
</style>
