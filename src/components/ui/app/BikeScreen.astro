---
import { Image } from 'astro:assets'
import AppStatusBar from './AppStatusBar.astro'
import AppTabBar from './AppTabBar.astro'
import bike from '@/assets/app/bike-naked.webp'

/**
 * The app's Bike tab, rebuilt as HTML so it renders live in a PhoneFrame
 * instead of shipping as a flat screenshot.
 *
 * Ported from myridesg-v2/apps/mobile:
 *   features/home/HomeGlow.tsx      → the orb wash (LIGHT_ORBS / DARK_ORBS)
 *   features/home/BikeHero.tsx      → the glass card + overhanging silhouette
 *   features/home/glass.ts          → --glass-* in global.css
 *   features/bikes/BikeKpiStrip.tsx → the four-up KPI row
 *   app/(app)/(tabs)/bike.tsx       → Key dates + Servicing sections
 *   features/bikes/LabeledRow.tsx   → the label/value rows in those sections
 *
 * The React Native source cannot be imported directly — it is built on RN
 * primitives, expo-router and react-query — so the markup is a port, but every
 * colour, string and proportion comes from those files rather than from taste.
 *
 * Sample data only, and the same values the flat capture this replaced was
 * showing, so the section did not silently change what it claims.
 */

const KPIS = [
  { label: 'km/L', value: '—' },
  { label: 'This month', value: '$58' },
  { label: '12 months', value: '$58' },
  { label: 'Odometer', value: '48,290' },
]

const KEY_DATES = [
  { label: 'Road tax', value: '4 Aug 2026' },
  { label: 'Insurance', value: '14 Sep 2026' },
  { label: 'COE expiry', value: '3 Feb 2029' },
]
---

<div class="bike">
  {/* HomeGlow. Six radial orbs over a top-anchored tint, same coordinates as
      the 300x600 viewBox in HomeGlow.tsx, expressed as percentages. */}
  <div class="bike__glow" aria-hidden="true"></div>

  <AppStatusBar time="10:27" />

  <div class="bike__body">
    <div class="bike__topbar">
      <span class="bike__switcher">
        <i class="bike__dot"></i>
        Honda CB400
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
          <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>

      <span class="bike__more" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
    </div>

    <div class="bike__hero">
      <div class="bike__card">
        <span class="bike__watermark" aria-hidden="true">CB400</span>

        <p class="bike__eyebrow">Honda · 2019</p>
        <p class="bike__model">CB400 Super Four</p>

        <div class="bike__headline">
          <p class="bike__eyebrow">Road tax due</p>
          <p class="bike__countdown">21 days</p>
          <p class="bike__trailing">expires 4 Aug</p>
          <p class="bike__cta">Renew now ›</p>
        </div>
      </div>

      {/* Sibling of the card, not a child — the card's rounded border must not
          clip it. Same trick as BikeHero.tsx. */}
      <Image src={bike} alt="" widths={[204, 408]} sizes="204px" class="bike__vehicle" loading="lazy" />
    </div>

    <div class="bike__kpis">
      {
        KPIS.map((kpi) => (
          <div class="bike__kpi">
            <p class="bike__kpi-label">{kpi.label}</p>
            <p class="bike__kpi-value">{kpi.value}</p>
          </div>
        ))
      }
    </div>

    <section class="bike__section">
      <h4 class="bike__section-title">Key dates</h4>
      <div class="bike__rows">
        {
          KEY_DATES.map((row) => (
            <div class="bike__row">
              <span class="bike__row-label">{row.label}</span>
              <span class="bike__row-value">{row.value}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="bike__section">
      <h4 class="bike__section-title">Servicing</h4>
      <div class="bike__rows">
        <div class="bike__row">
          <span class="bike__row-label">Oil interval</span>
          <span class="bike__row-value">every 3,000 km</span>
        </div>
      </div>
    </section>
  </div>

  <AppTabBar />
</div>

<style>
  .bike {
    position: relative;
    isolation: isolate;
    height: 100%;
    overflow: hidden;
  }

  /* ── HomeGlow ───────────────────────────────────────────────────────────
     LIGHT_ORBS / DARK_ORBS from HomeGlow.tsx, converted from that file's
     300x600 viewBox to percentages, over the same top-anchored TOP_TINT.

     One stack rather than two: every stop picks its scheme with light-dark(),
     so there is no second copy to fall out of sync. The geometry is the light
     set — the two differ by a few percent on the top three orbs and not at all
     on the rest, and the colour and opacity are what actually carry the
     difference between the schemes. */
  .bike__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        80% 26% at 27% -5%,
        light-dark(rgba(192, 20, 16, 0.62), rgba(227, 6, 19, 0.6)),
        transparent 70%
      ),
      radial-gradient(
        80% 26% at 83% -7%,
        light-dark(rgba(202, 1, 1, 0.56), rgba(214, 50, 28, 0.55)),
        transparent 70%
      ),
      radial-gradient(
        55% 18% at 53% 10%,
        light-dark(rgba(176, 16, 8, 0.55), rgba(227, 6, 19, 0.5)),
        transparent 70%
      ),
      radial-gradient(
        50% 18% at 95% 37%,
        light-dark(rgba(57, 57, 57, 0.12), rgba(214, 50, 28, 0.22)),
        transparent 70%
      ),
      radial-gradient(
        67% 20% at 13% 50%,
        light-dark(rgba(224, 220, 220, 0.4), rgba(224, 220, 220, 0.12)),
        transparent 70%
      ),
      radial-gradient(
        92% 24% at 53% 75%,
        light-dark(rgba(224, 220, 220, 0.4), rgba(57, 57, 57, 0.2)),
        transparent 70%
      ),
      linear-gradient(to bottom, light-dark(#b0140c, #3a0d07), transparent 32%);
  }

  .bike__body {
    display: flex;
    flex-direction: column;
    gap: 1.15em;
    /* Top clears the status bar (2.9em safe area), bottom clears the tab bar.
       Both are positioned over this, so neither takes any flow. */
    padding: 3.6em 1em 6em;
  }

  /* ── Bike switcher ──────────────────────────────────────────────────────
     Consumes the same GLASS palette as the hero card, so chip and card read
     as one surface (glass.ts says so explicitly). */
  .bike__topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bike__switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 0.75em;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-fill);
    color: #ffffff; /* GLOW_HEADER.title — scheme-invariant on the red wash. */
    font-size: 1.1em;
    font-weight: 600;
  }

  .bike__switcher svg {
    inline-size: 1em;
    block-size: 1em;
    opacity: 0.75;
  }

  .bike__dot {
    inline-size: 0.5em;
    block-size: 0.5em;
    border-radius: 999px;
    background: #34d399;
  }

  .bike__more {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    padding: 0.3em;
  }

  .bike__more i {
    inline-size: 0.2em;
    block-size: 0.2em;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72); /* GLOW_HEADER.eyebrow */
  }

  /* ── Hero ───────────────────────────────────────────────────────────────
     minHeight 196, marginRight 52, radius 24 — BikeHero.tsx, scaled. */
  .bike__hero {
    position: relative;
  }

  .bike__card {
    position: relative;
    min-height: 13em;
    margin-inline-end: 3.4em;
    padding: 1.2em;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 1.6em;
    background: var(--glass-fill);
  }

  .bike__watermark {
    position: absolute;
    /* BikeHero.tsx puts this at top 52, right 14 with fontSize 64. These are
       em on an element that sets its own font-size, so they resolve against
       THAT size, not the card's: 52/64 and 14/64, not 3.25 and 0.875. */
    top: 0.81em;
    right: 0.22em;
    z-index: 0;
    font-family: var(--font-display);
    font-size: 4.2em;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--glass-watermark);
  }

  .bike__eyebrow {
    position: relative;
    z-index: 2;
    font-size: 0.85em;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--glass-muted);
  }

  .bike__model,
  .bike__countdown {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 2.1em;
    font-weight: 700;
    line-height: 1.05;
    color: var(--glass-title);
  }

  /* numberOfLines={1} in BikeHero.tsx — the model is a single line there, and
     wrapping it here pushed the deadline down into the silhouette. */
  .bike__model {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* absolute left/right 18, bottom 16 — BikeHero.tsx. Pinning it means the
     deadline sits at the card's foot whatever the model name does above it. */
  .bike__headline {
    position: absolute;
    inset-inline: 1.2em;
    bottom: 1em;
    z-index: 2;
  }

  /* The deadline is the one thing on this card that must read as urgent. */
  .bike__countdown {
    color: var(--glass-urgent);
    font-variant-numeric: tabular-nums;
  }

  .bike__trailing {
    position: relative;
    z-index: 2;
    margin-top: 0.4em;
    font-size: 0.85em;
    color: var(--glass-soft);
  }

  .bike__cta {
    position: relative;
    z-index: 2;
    margin-top: 0.6em;
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--glass-urgent);
  }

  .bike__vehicle {
    position: absolute;
    right: -0.4em;
    bottom: 0.5em;
    z-index: 5;
    inline-size: 13em;
    block-size: auto;
  }

  /* ── KPI strip ──────────────────────────────────────────────────────────*/
  .bike__kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5em;
  }

  .bike__kpi {
    padding: 0.65em 0.6em;
    border: 1px solid var(--app-border);
    border-radius: 1.1em;
    background: var(--app-card);
    min-inline-size: 0;
  }

  .bike__kpi-label,
  .bike__row-label {
    font-size: 0.75em;
    color: var(--app-muted-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bike__kpi-value {
    margin-top: 0.1em;
    font-size: 1em;
    font-weight: 600;
    color: var(--app-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Key dates / Servicing ──────────────────────────────────────────────*/
  .bike__section-title {
    font-family: var(--font-sans);
    font-size: 1.05em;
    font-weight: 600;
    color: var(--app-fg);
  }

  .bike__rows {
    margin-top: 0.55em;
    padding-inline: 1em;
    border: 1px solid var(--app-border);
    border-radius: 1.1em;
    background: var(--app-card);
  }

  .bike__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    padding-block: 0.75em;
  }

  /* Every row but the first draws its own hairline — LabeledRow's `divider`. */
  .bike__row + .bike__row {
    border-top: 1px solid color-mix(in oklab, var(--app-border) 60%, transparent);
  }

  .bike__row-value {
    font-size: 0.9em;
    font-weight: 600;
    color: var(--app-fg);
    white-space: nowrap;
  }
</style>
