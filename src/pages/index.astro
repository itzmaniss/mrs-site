---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import Hero from '@/components/ui/Hero.astro'
import Ticker from '@/components/ui/Ticker.astro'
import SingaporeOwnership from '@/components/ui/SingaporeOwnership.astro'
import Product from '@/components/ui/Product.astro'
import HowItWorks from '@/components/ui/HowItWorks.astro'
import Workshops from '@/components/ui/Workshops.astro'
import RiderTools from '@/components/ui/RiderTools.astro'
import Pricing from '@/components/ui/Pricing.astro'
import Privacy from '@/components/ui/Privacy.astro'
import Faq from '@/components/ui/Faq.astro'
import FinalCta from '@/components/ui/FinalCta.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'
---

<BaseLayout>
  <SiteNav />

  <main>
    <Hero />
    <Ticker />
    <SingaporeOwnership />
    <Product />
    <HowItWorks />
    <Workshops />
    <RiderTools />
    <Pricing />
    <Privacy />
    <Faq />
    <FinalCta />
  </main>

  <SiteFooter />
</BaseLayout>
