---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SiteNav from '@/components/ui/SiteNav.astro'
import SiteFooter from '@/components/ui/SiteFooter.astro'

// Astro emits this as dist/404.html rather than 404/index.html, which is the
// filename both Cloudflare Pages and nginx look for.
//
// noindex matters here: without a 404 page the host falls back to serving the
// homepage with a 200, and search engines read that as a soft 404 on every
// mistyped URL.
---

<BaseLayout
  title="Page not found"
  description="That page could not be found. Everything on MyRideSG is reachable from the homepage."
  noindex
>
  <SiteNav />

  <main class="flex min-h-[75vh] items-center bg-paper py-24">
    <div class="shell">
      <div class="mx-auto max-w-xl text-center">
        <p class="eyebrow text-red">Error 404</p>

        <h1 class="mt-4 text-display-sm md:text-display">We could not find that page.</h1>

        <p class="mx-auto mt-5 max-w-md text-lg leading-relaxed text-muted">
          The link may be out of date, or the address may have a small typo in it.
          Everything on the site is reachable from the homepage.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/"
            class="inline-flex min-h-12 items-center rounded-pill bg-ember px-7 text-md font-semibold text-on-dark transition-opacity hover:opacity-85"
          >
            Back to the homepage
          </a>

          <a
            href="/#faq"
            class="inline-flex min-h-12 items-center rounded-pill border border-ink/15 px-7 text-md font-semibold transition-colors hover:bg-soft"
          >
            Read the FAQ
          </a>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
